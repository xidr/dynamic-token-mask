<div class="mask-editor-content">
  <div class="mask-path">
    <label>
      {{localize "DTM.Image"}}
      <file-picker name="src" type="image" value="{{src}}" noupload></file-picker>
    </label>
    <button type="button" data-action="load">{{localize "DTM.Load"}}</button>
  </div>
  <p class="mask-status" role="status"></p>
  <div class="mask-workspace" hidden>
    <div class="mask-art">
      <label>{{localize "DTM.Editing"}} <output class="mask-current-source"></output></label>
      <canvas class="mask-source" role="img" aria-label="{{localize 'DTM.Source'}}"></canvas>
      <p class="hint">{{localize "DTM.Help"}}</p>
    </div>
    <div class="mask-controls">
      <figure>
        <canvas class="mask-preview" role="img" aria-label="{{localize 'DTM.Preview'}}"></canvas>
        <figcaption>{{localize "DTM.Preview"}}</figcaption>
      </figure>
      <label>{{localize "DTM.CenterX"}} <input name="centerX" type="number" min="0" max="100" step="any"></label>
      <label>{{localize "DTM.CenterY"}} <input name="centerY" type="number" min="0" max="100" step="any"></label>
      <label>{{localize "DTM.Radius"}} <input name="radius" type="number" min="0.1" max="50" step="any"></label>
      <input name="radiusSlider" type="range" min="0.1" max="50" step="any" aria-label="{{localize 'DTM.Radius'}}">
    </div>
  </div>
  <p class="hint mask-shared">{{localize "DTM.Shared"}}</p>
  <footer class="mask-actions">
    <button type="button" data-action="reset" disabled>{{localize "DTM.Reset"}}</button>
    <button type="button" data-action="remove" disabled>{{localize "DTM.Remove"}}</button>
    <button type="button" data-action="cancel">{{localize "DTM.Cancel"}}</button>
    <button type="button" data-action="save" disabled>{{localize "DTM.Save"}}</button>
  </footer>
</div>
